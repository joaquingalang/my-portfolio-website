# EmailJS credentials used by the contact form (src/config/env.ts).
# Copy this file to `.env` and fill in the values from https://dashboard.emailjs.com/
# These are exposed to the browser by design — only use the public key here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
