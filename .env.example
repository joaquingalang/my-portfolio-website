# EmailJS credentials used by the contact form (src/config/env.ts).
# Copy this file to `.env` and fill in the values from https://dashboard.emailjs.com/
# These are exposed to the browser by design — only use the public key here.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Calling card (/c and /e) — server-side visit counter.
# Provisioned automatically by the Upstash Redis integration in the Vercel
# Marketplace. Only needed locally if you want `npm run stats` to read numbers
# back; the card renders fine without them (the write is skipped, not retried).
# The KV_REST_API_* pair from the older Vercel KV integration is also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reading Vercel Web Analytics back via `npm run stats`.
# NOT `VITE_`-prefixed on purpose: Vite inlines every VITE_* variable into the
# client bundle, and this token is account-scoped. It must never reach a browser.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=prj_kFylDfcceA6DcqwjlUzeoa2ebcDt
VERCEL_TEAM_ID=team_iz70zua8XzMAeAUXQk3IcD17
